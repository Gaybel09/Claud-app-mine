ENVIRONMENT=development

# Em produção (ex: Render), DATABASE_URL e REDIS_URL costumam vir prontos do
# provedor gerenciado e têm prioridade sobre os campos POSTGRES_*/REDIS_*
# abaixo -- deixe-os vazios/ausentes no dev local com docker-compose.
# DATABASE_URL=postgresql://user:pass@host:5432/dbname
# REDIS_URL=redis://host:6379/0

POSTGRES_USER=cubemine
POSTGRES_PASSWORD=cubemine
POSTGRES_DB=cubemine_pix
POSTGRES_HOST=db
POSTGRES_PORT=5432

REDIS_HOST=redis
REDIS_PORT=6379

# Credencial do Firebase Admin. FIREBASE_CREDENTIALS_JSON (o JSON da service
# account colado como texto) tem prioridade sobre FIREBASE_CREDENTIALS_FILE
# (caminho de arquivo); se nenhuma estiver setada, usa Application Default
# Credentials (só funciona em infra do GCP).
FIREBASE_CREDENTIALS_JSON=
FIREBASE_CREDENTIALS_FILE=

# Integração Pix via Efí (seção 11) -- sandbox por padrão (EFI_SANDBOX=true).
# Onde conseguir cada valor no painel da Efí (sejaefi.com.br):
#   1. Crie/entre numa conta (a de sandbox é separada da de produção).
#   2. Menu "Minhas Aplicações" -> crie uma aplicação com escopo "pix.send"
#      -> copia EFI_CLIENT_ID e EFI_CLIENT_SECRET de lá.
#   3. Menu "Certificados" -> gere o certificado da conta (mTLS, exigido em
#      toda chamada) -> baixe o .p12/.pem. Use EFI_CERTIFICATE_PATH com o
#      caminho do arquivo, OU EFI_CERTIFICATE_BASE64 com o conteúdo em
#      base64 como texto (prioridade sobre EFI_CERTIFICATE_PATH -- útil em
#      provedores sem upload de arquivo secreto, ex: Render sem Secret
#      Files). Ex: `base64 -w0 certificado.pem`.
#   4. Cadastre uma chave Pix na própria conta Efí (a que vai pagar os
#      saques) e coloque em EFI_PAYER_PIX_KEY.
#   5. Configure o webhook de envio de Pix apontando para
#      https://SEU_HOST/pix/webhook (painel Efí -> Webhooks).
EFI_CLIENT_ID=
EFI_CLIENT_SECRET=
EFI_CERTIFICATE_PATH=
EFI_CERTIFICATE_BASE64=
EFI_SANDBOX=true
EFI_PAYER_PIX_KEY=
