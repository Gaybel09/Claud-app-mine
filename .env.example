ENVIRONMENT=development

# Em produção (ex: Render), DATABASE_URL e REDIS_URL costumam vir prontos do
# provedor gerenciado e têm prioridade sobre os campos POSTGRES_*/REDIS_*
# abaixo -- deixe-os vazios/ausentes no dev local com docker-compose.
# DATABASE_URL=postgresql://user:pass@host:5432/dbname
# REDIS_URL=redis://host:6379/0

POSTGRES_USER=cubemine
POSTGRES_PASSWORD=cubemine
POSTGRES_DB=cubemine_pix
POSTGRES_HOST=db
POSTGRES_PORT=5432

REDIS_HOST=redis
REDIS_PORT=6379

# Credencial do Firebase Admin. FIREBASE_CREDENTIALS_JSON (o JSON da service
# account colado como texto) tem prioridade sobre FIREBASE_CREDENTIALS_FILE
# (caminho de arquivo); se nenhuma estiver setada, usa Application Default
# Credentials (só funciona em infra do GCP).
FIREBASE_CREDENTIALS_JSON=
FIREBASE_CREDENTIALS_FILE=

# Integração Pix via Efí (seção 11) -- sandbox por padrão (EFI_SANDBOX=true).
# Onde conseguir cada valor no painel da Efí (sejaefi.com.br):
#   1. Crie/entre numa conta (a de sandbox é separada da de produção).
#   2. Menu "Minhas Aplicações" -> crie uma aplicação com escopo "pix.send"
#      -> copia EFI_CLIENT_ID e EFI_CLIENT_SECRET de lá.
#   3. Menu "Meus certificados" -> gere o certificado da conta (mTLS,
#      exigido em toda chamada, inclusive a autenticação). A Efí só entrega
#      um .p12 (PKCS#12) -- o Python não lê esse formato direto, então
#      converta pra PEM combinado (certificado + chave, sem senha) antes:
#        openssl pkcs12 -in certificado.p12 -out certificado.pem -nodes -legacy
#      (o -legacy costuma ser necessário com OpenSSL 3.x). Aí escolha UMA
#      destas três formas de configurar o certificado.pem resultante, em
#      ordem de prioridade caso mais de uma esteja setada:
#        EFI_CERTIFICATE_PEM      -- o conteúdo do .pem colado direto como
#                                    texto (mais simples, sem conversão)
#        EFI_CERTIFICATE_BASE64   -- o mesmo conteúdo em base64
#                                    (`base64 -w0 certificado.pem`), útil se
#                                    seu mecanismo de env vars não aceita
#                                    texto multilinha de forma confiável
#        EFI_CERTIFICATE_PATH     -- caminho do arquivo .pem no disco (ex:
#                                    um Secret File já montado)
#   4. Cadastre uma chave Pix na própria conta Efí (a que vai pagar os
#      saques) e coloque em EFI_PAYER_PIX_KEY.
#   5. Configure o webhook de envio de Pix apontando para
#      https://SEU_HOST/pix/webhook -- direto no painel Efí (Webhooks) ou
#      chamando GET /admin/register-efi-webhook (ver abaixo).
EFI_CLIENT_ID=
EFI_CLIENT_SECRET=
EFI_CERTIFICATE_PEM=
EFI_CERTIFICATE_BASE64=
EFI_CERTIFICATE_PATH=
EFI_SANDBOX=true
EFI_PAYER_PIX_KEY=

# URL pública em que a própria API está hospedada -- só usada para montar a
# URL de webhook em GET /admin/register-efi-webhook
# (PUBLIC_BASE_URL + "/pix/webhook"). Não é secreta.
PUBLIC_BASE_URL=https://cubemine-pix-api.onrender.com

# Protege GET /admin/smoke-test/pix e GET /admin/register-efi-webhook
# (diagnóstico manual -- ver app/modules/admin/). Sem essa variável setada,
# as rotas respondem 404 como se não existissem -- nunca ficam acessíveis
# "por padrão". Gere um valor forte com:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# REMOVA esta variável (ou deixe de configurá-la) antes de operar fora de
# sandbox, em produção de verdade.
ADMIN_SMOKE_TEST_TOKEN=
